{
    "name": "gentics/portal-php",
    "description": "Gentics Portal | php",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "ext-json": "*",
        "barryvdh/laravel-stack-middleware": "^1.4.0",
        "bensampo/laravel-enum": "^6.12.01",
        "dflydev/apache-mime-types": "~1.0.1",
        "friendsofsymfony/http-cache": "~3.1.0",
        "friendsofsymfony/http-cache-bundle": "^3.1.0",
        "gentics/mesh-php-client": "0.20.6",
        "guzzlehttp/psr7": "^2.7",
        "lcobucci/jwt": "~4.1.5",
        "netresearch/jsonmapper": "~4.0.0",
        "ocramius/package-versions": "~2.11.0",
        "php-http/guzzle7-adapter": "~1.0.0",
        "socialiteproviders/manager": "^4.8.0",
        "spatie/laravel-sitemap": "~8.0",
        "symfony/psr-http-message-bridge": "~7.2.0",
        "zonuexe/http-accept-language": "~0.4.1",
        "knuckleswtf/scribe": "^5.8"
    },
    "require-dev": {
        "composer/composer": "^2.3.9",
        "enlightn/security-checker": "~2.0.0",
        "friendsofphp/php-cs-fixer": "~3.95.0",
        "gentics/composer-plugin-license-check": "~1.1.0",
        "orchestra/testbench": "^11.0",
        "overtrue/phplint": "~9.5.5",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "~3.13.6"
    },
    "autoload": {
        "psr-4": {
            "Gentics\\PortalPhp\\": "src/"
        },
        "files": [
            "src/helpers.php",
            "src/collision.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Gentics\\PortalPhp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gentics\\PortalPhp\\Providers\\ServiceProvider"
            ]
        },
        "metasyntactical/composer-plugin-license-check": {
            "whitelist": [
                "Apache2",
                "Apache-2.0",
                "BSD",
                "BSD-2-Clause",
                "BSD-3-Clause",
                "MIT",
                "OSL-3.0",
                "WTFPL"
            ],
            "blacklist": []
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "gentics/composer-plugin-license-check": true,
            "iodigital-com/composer-git-hooks": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": [
            "phplint src/",
            "php-cs-fixer fix --dry-run --verbose",
            "phpcs src/"
        ],
        "securitycheck": [
            "security-checker security:check composer.lock"
        ],
        "phpunit": [
            "phpunit tests/"
        ],
        "test": [
            "@composer validate",
            "@lint",
            "@phpunit",
            "@securitycheck"
        ],
        "fixcode": [
            "php-cs-fixer fix"
        ],
        "docs-openapi": [
            "./vendor/bin/testbench portal:openapi:generate"
        ],
        "build": [
            "@composer install",
            "mkdir -p .reports",
            "./vendor/bin/phplint src/",
            "./vendor/bin/php-cs-fixer fix --dry-run --format=junit > .reports/php-cs-fixer.xml || true",
            "./vendor/bin/phpcs --report=junit --report-file=.reports/phpcs.xml src/ || true",
            "./vendor/bin/phpunit --log-junit=.reports/phpunit.xml tests/ || true",
            "./vendor/bin/security-checker security:check composer.lock",
            "@docs-openapi"
        ]
    }
}
